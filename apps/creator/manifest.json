{
  "manifest_version": 3,
  "name": "Creator",
  "description": "Base Level Extension",
  "version": "1.0",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "action": {
    "default_popup": "creator.html",
    "default_icon": "creator_extensions.png"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": ["scripts/content.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
