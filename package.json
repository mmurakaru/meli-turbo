{
	"name": "meli-turbo",
	"private": true,
	"scripts": {
		"change": "pnpm changeset",
		"commit": "pnpx git-cz",
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"prepare": "husky",
		"format-and-lint": "biome check --no-errors-on-unmatched",
		"format-and-lint:fix": "biome check --write --no-errors-on-unmatched",
		"format-and-lint:staged": "biome check --write --no-errors-on-unmatched --staged"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@changesets/cli": "^3.0.3",
		"husky": "^9.1.7",
		"turbo": "^2.11.10",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@10.34.7",
	"pnpm": {
		"overrides": {
			"@types/react": "19.3.0",
			"@types/react-dom": "19.3.0",
			"protobufjs": ">=8.6.0",
			"postcss@<8.5.10": ">=8.5.10",
			"valibot@<1.4.2": ">=1.4.2",
			"@esbuild-kit/core-utils>esbuild": "^0.25.12"
		}
	},
	"engines": {
		"node": ">=24"
	}
}
