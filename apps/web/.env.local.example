# Database
POSTGRES_URL=postgresql://***

# Stripe
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***

# App
BASE_URL=http://localhost:3000

# Session — generate with: openssl rand -base64 32
SESSION_SECRET=***

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=***
GOOGLE_CLIENT_SECRET=***

# Cortex AI service (services/cortex)
# Web signs a short-lived RS256 JWT per request with this PEM private key; Cortex verifies
# it with the matching public key (JWT_PUBLIC_KEY in services/cortex/.env).
# Keypair setup: see "JWT authentication" in services/cortex/README.md.
CORTEX_URL=http://localhost:3001
CORTEX_JWT_PRIVATE_KEY=