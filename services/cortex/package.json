{
  "name": "@meli/cortex",
  "version": "1.5.0",
  "engines": {
    "node": ">=24.5.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "copy:config": "cpy --rename=.env ./.env.default ./",
    "test": "vitest",
    "test:migrate": "cross-env NODE_ENV=test DATABASE_URL=postgres://serviceuser:pass@localhost:5432/service_db_test npx drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "test:coverage": "node --run test -- --coverage",
    "test:ci": "node --run copy:config && node --run test:migrate && node --run test:coverage",
    "lint": "biome check . && tsc && npm run docs:validate",
    "lint:fix": "biome check --write .",
    "start:dev": "node --env-file=.env src/server.ts",
    "start:dev:watch": "node --watch --env-file=.env src/server.ts",
    "start:prod": "node --run build && cross-env NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "start:prod:smoke-test": "sh -c 'npm run start:prod > .smoke.log 2>&1 & APP_PID=$!; trap \"kill $APP_PID 2>/dev/null\" EXIT INT TERM; for i in $(seq 1 30); do curl -fsS http://localhost:3000/health >/dev/null 2>&1 && echo \"Health check passed\" && exit 0 || sleep 1; done; echo \"Timeout: Health check failed after 30 seconds\"; tail -n +1 .smoke.log || true; exit 1'",
    "free-ports": "npx cross-port-killer 3000",
    "docker:start:dev": "docker compose up -d --quiet-pull --wait",
    "docker:stop:dev": "docker compose down",
    "db:generate-migrations": "cross-env NODE_ENV=development npx drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:apply-migrations": "cross-env NODE_ENV=development npx drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:drop-migrations": "cross-env NODE_ENV=development npx drizzle-kit drop --config=./src/db/drizzle.config.ts",
    "docs:generate": "node scripts/generateEnvDocs.ts",
    "docs:validate": "node scripts/validateEnvDocs.ts",
    "prepublishOnly": "node --run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@effect/opentelemetry": "4.1.1",
    "@effect/sql-pg": "4.1.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/swagger": "^9.9.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@scalar/fastify-api-reference": "^1.76.4",
    "ai": "^7.0.159",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "effect": "4.1.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg": "8.23.1",
    "posthog-node": "5.61.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@effect/vitest": "4.1.1",
    "@lokalise/biome-config": "^4.0.0",
    "@lokalise/tsconfig": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@biomejs/cli-darwin-arm64": "^2.6.4",
    "@biomejs/cli-linux-arm64": "^2.6.4",
    "@biomejs/cli-linux-x64": "^2.6.4",
    "@biomejs/cli-win32-x64": "^2.6.4",
    "@esbuild/darwin-arm64": "^0.28.2",
    "@esbuild/linux-arm64": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-darwin-arm64": "^4.67.2",
    "@rollup/rollup-linux-arm64-gnu": "^4.67.2",
    "@rollup/rollup-linux-x64-gnu": "^4.67.2",
    "@rollup/rollup-win32-x64-msvc": "^4.67.2"
  }
}
