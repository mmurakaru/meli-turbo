# database
DATABASE_URL=postgresql://cortexuser:pass@localhost:5433/cortex?application_name=cortex
DATABASE_MAX_CONNECTIONS=10

# redis (result cache + BullMQ)
REDIS_HOST=localhost
REDIS_KEY_PREFIX=cortex
REDIS_PORT=6380
REDIS_PASSWORD=sOmE_sEcUrE_pAsS
REDIS_USE_TLS=false

# queue
QUEUE_CONCURRENCY=5

# ai
AI_BASE_URL=http://localhost:11434/v1
# Lightweight default for local dev (low RAM). Switch to qwen2.5:7b or qwen3 for better quality.
AI_MODEL=qwen2.5:3b
AI_API_KEY=ollama

# posthog (error tracking + analytics; capture is a no-op without a key)
# POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# observability
OTEL_SERVICE_NAME=cortex
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
METRICS_PROMETHEUS_PORT=9080
