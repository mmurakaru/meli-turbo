{
	"name": "web",
	"version": "1.0.0",
	"description": "Meli - AI spreadsheet builder",
	"private": true,
	"scripts": {
		"build": "next build",
		"setup": "npx tsx lib/db/setup.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "npx tsx lib/db/seed.ts",
		"stripe:setup": "npx tsx lib/db/stripe-setup.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "next dev --turbo",
		"lint": "biome check --no-errors-on-unmatched",
		"lint:fix": "biome check --write --no-errors-on-unmatched",
		"start": "next start",
		"jwt:generate": "node --experimental-strip-types scripts/generateJwt.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@googleapis/sheets": "^18.1.2",
		"@next/env": "^16.4.3",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-table": "^9.3.1",
		"@tiptap/core": "^3.32.2",
		"@tiptap/extension-placeholder": "^3.32.2",
		"@tiptap/react": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"@tiptap/suggestion": "^3.32.2",
		"@workspace/ui": "workspace:*",
		"arctic": "^3.7.0",
		"bcryptjs": "^3.0.3",
		"date-fns": "^4.4.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"fast-jwt": "^6.3.6",
		"google-one-tap": "^1.0.6",
		"jose": "^6.2.14",
		"lucide-react": "^1.66.0",
		"meli.js": "1.0.10-alpha",
		"next": "16.4.3",
		"papaparse": "^5.7.0",
		"postcss": "^8.5.32",
		"postgres": "^4.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "^0.0.1",
		"stripe": "^23.1.0",
		"uuid": "^14.0.3",
		"xlsx": "^0.18.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/google-one-tap": "^1.2.7",
		"@types/node": "^26.6.6",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
