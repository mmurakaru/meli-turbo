{
	"name": "meli-turbo",
	"private": true,
	"scripts": {
		"change": "pnpm changeset",
		"commit": "pnpx git-cz",
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"prepare": "husky",
		"format-and-lint": "biome check --no-errors-on-unmatched",
		"format-and-lint:fix": "biome check --write --no-errors-on-unmatched",
		"format-and-lint:staged": "biome check --write --no-errors-on-unmatched --staged"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@changesets/cli": "^2.28.1",
		"husky": "^9.1.7",
		"turbo": "^2.5.0",
		"typescript": "5.8.2"
	},
	"packageManager": "pnpm@10.7.1",
	"engines": {
		"node": ">=22"
	}
}
