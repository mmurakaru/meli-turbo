{
  "name": "creator-chrome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-watch",
    "build": "next build && npm run lint:build && node clean-html.js",
    "start": "pnpx serve@latest out",
    "lint:build": "mv out/_next out/assets && gsed -i 's/\\/_next/\\/assets/g' out/**.html",
    "lint": "next lint"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@types/chrome": "^0.0.283",
    "lucide-react": "^0.454.0",
    "next": "15.0.3",
    "react": "18.03.01",
    "react-dom": "18.03.01",
    "react-router-dom": "^6.28.0",
    "sass": "^1.81.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cheerio": "^1.0.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "npm-watch": "^0.13.0",
    "postcss": "^8",
    "saas": "^1.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "watch": {
    "build": {
      "patterns": [
        ".",
        "styles/**",
        "pages/**",
        "public/**"
      ],
      "ignore": [
        "out",
        "node_modules",
        ".next"
      ],
      "extensions": [
        "js",
        "json",
        "lock",
        "tsx",
        "ts"
      ]
    }
  }
}
