{
	"name": "web",
	"version": "1.0.0",
	"description": "Meli - AI spreadsheet builder",
	"private": true,
	"scripts": {
		"build": "next build",
		"setup": "npx tsx lib/db/setup.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "npx tsx lib/db/seed.ts",
		"stripe:setup": "npx tsx lib/db/stripe-setup.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "next dev --turbo",
		"lint": "biome check --no-errors-on-unmatched",
		"lint:fix": "biome check --write --no-errors-on-unmatched",
		"start": "next start",
		"jwt:generate": "node --experimental-strip-types scripts/generateJwt.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@googleapis/sheets": "^13.0.1",
		"@next/env": "^16.2.9",
		"@t3-oss/env-nextjs": "^0.13.10",
		"@tanstack/react-table": "^8.20.6",
		"@tiptap/core": "^3.22.1",
		"@tiptap/extension-placeholder": "^3.22.1",
		"@tiptap/react": "^3.21.0",
		"@tiptap/starter-kit": "^3.20.1",
		"@tiptap/suggestion": "^3.22.1",
		"@workspace/ui": "workspace:*",
		"arctic": "^3.7.0",
		"bcryptjs": "^3.0.2",
		"date-fns": "^4.1.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"fast-jwt": "^6.1.0",
		"google-one-tap": "^1.0.6",
		"jose": "^6.2.2",
		"lucide-react": "^1.7.0",
		"meli.js": "1.0.10-alpha",
		"next": "16.2.2",
		"papaparse": "^5.5.3",
		"postcss": "^8.5.8",
		"postgres": "^3.4.8",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"server-only": "^0.0.1",
		"stripe": "^20.4.1",
		"uuid": "^13.0.0",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/bcryptjs": "^3.0.0",
		"@types/google-one-tap": "^1.2.6",
		"@types/node": "^25.5.2",
		"@types/papaparse": "^5.3.16",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.2.5",
		"typescript": "^6.0.2",
		"vitest": "^4.0.18"
	}
}
